# Get this from @BotFather on Telegram
BOT_TOKEN=123456789:your-telegram-bot-token-here

# Optional — only needed once you wire up full backlink discovery
# (Ahrefs / Moz / SEMrush / similar). Leave blank for now.
BACKLINK_API_KEY=

# Railway sets NODE_ENV automatically in production; safe to leave unset locally
NODE_ENV=development
